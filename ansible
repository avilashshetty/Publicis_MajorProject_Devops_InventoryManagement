---
- name: Deploy Inventory Management Application
  hosts: all
  become: yes
  vars:
    app_name: inventory-management
    docker_image: shikharsharma/inventory-management-app   # you can push to Docker Hub with this name
    docker_tag: latest
    app_port: 3000        # update if your app uses a different port
    mongodb_port: 27017
    namespace: inventory-management
 
  tasks:
    - name: Update system packages
      apt:
        update_cache: yes
        upgrade: dist
      when: ansible_os_family == "Debian"
 
    - name: Install required packages
      apt:
        name:
          - docker.io
          - docker-compose
          - curl
          - git
          - nodejs
          - npm
        state: present
      when: ansible_os_family == "Debian"
 
    - name: Start and enable Docker service
      systemd:
        name: docker
        state: started
        enabled: yes
 
    - name: Add user to docker group
      user:
        name: "{{ ansible_user }}"
        groups: docker
        append: yes
 
    - name: Create application directory
      file:
        path: /opt/{{ app_name }}
        state: directory
        owner: "{{ ansible_user }}"
        group: "{{ ansible_user }}"
        mode: '0755'
 
    - name: Clone Inventory Management repository
      git:
        repo: https://github.com/naruto-o/Publicis_MajorProject_Devops_InventoryManagement.git
        dest: /opt/{{ app_name }}
        version: master
        force: yes
      become_user: "{{ ansible_user }}"
 
    - name: Install Node.js dependencies
      npm:
        path: /opt/{{ app_name }}
        state: present
      become_user: "{{ ansible_user }}"
 
    - name: Create Docker network for Inventory Management
      docker_network:
        name: "{{ app_name }}-network"
        state: present
 
    - name: Pull MongoDB Docker image
      docker_image:
        name: mongo:6.0
        source: pull
 
    - name: Pull Inventory Management Docker image
      docker_image:
        name: "{{ docker_image }}:{{ docker_tag }}"
        source: pull
 
    - name: Create MongoDB data volume
      docker_volume:
        name: "{{ app_name }}-mongo-data"
        state: present
 
    - name: Run MongoDB container
      docker_container:
        name: "{{ app_name }}-mongodb"
        image: mongo:6.0
        state: started
        restart_policy: always
        networks:
          - name: "{{ app_name }}-network"
        ports:
          - "{{ mongodb_port }}:27017"
        env:
          MONGO_INITDB_DATABASE: inventorydb
          MONGO_INITDB_ROOT_USERNAME: admin
          MONGO_INITDB_ROOT_PASSWORD: password123
        volumes:
          - "{{ app_name }}-mongo-data:/data/db"
 
    - name: Wait for MongoDB to be ready
      wait_for:
        port: "{{ mongodb_port }}"
        host: localhost
        delay: 10
        timeout: 60
 
    - name: Run Inventory Management application container
      docker_container:
        name: "{{ app_name }}-app"
        image: "{{ docker_image }}:{{ docker_tag }}"
        state: started
        restart_policy: always
        networks:
          - name: "{{ app_name }}-network"
        ports:
          - "{{ app_port }}:3000"
        env:
          MONGODB_URI: "mongodb://{{ app_name }}-mongodb:27017/inventorydb"
          JWT_SECRET: "production_secret_123"
          NODE_ENV: "production"
          PORT: "3000"
        depends_on:
          - "{{ app_name }}-mongodb"
 
    - name: Wait for Inventory Management application to be ready
      wait_for:
        port: "{{ app_port }}"
        host: localhost
        delay: 15
        timeout: 120
 
    - name: Test application health endpoint
      uri:
        url: "http://localhost:{{ app_port }}/health"
        method: GET
        status_code: 200
      register: health_check
      retries: 5
      delay: 10
      until: health_check.status == 200
      ignore_errors: yes
 
    - name: Display deployment status
      debug:
        msg: |
          Inventory Management Deployment Complete!
          Application URL: http://{{ ansible_default_ipv4.address }}:{{ app_port }}
          MongoDB URL: mongodb://{{ ansible_default_ipv4.address }}:{{ mongodb_port }}
          Health Check: {{ 'PASSED' if health_check.status == 200 else 'FAILED' }}
 
    - name: Create systemd service for Inventory Management
      template:
        src: inventory-management.service.j2
        dest: /etc/systemd/system/inventory-management.service
      notify: reload systemd
 
    - name: Enable and start Inventory Management service
      systemd:
        name: inventory-management
        enabled: yes
        state: started
        daemon_reload: yes
 
  handlers:
    - name: reload systemd
      systemd:
        daemon_reload: yes
